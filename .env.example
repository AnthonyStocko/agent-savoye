# =============================================================================
# Configuration de l'Agent Scrum Master
# Copier ce fichier en .env puis compléter (ou tout saisir dans l'onglet ⚙️ Configuration de l'IHM).
# Les valeurs ci-dessous sont celles de l'environnement Savoye / Odatio.
# =============================================================================

# --- Jira (obligatoire) ------------------------------------------------------
JIRA_DOMAIN=savoye.atlassian.net
JIRA_EMAIL=prenom.nom@savoye.com
# Jeton personnel : https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SPEC

# --- Recherche Jira : valeurs pré-remplies dans l'onglet Lancement -------------
# Équipe / composant (composant Jira ou équipe Atlassian), statuts et labels séparés par des virgules
JIRA_SEARCH_TEAM=
JIRA_SEARCH_STATUSES="Analysée, Analysé"
JIRA_SEARCH_LABELS=WAIT_TEAM_SPEC
# Recherche rapide « Épopées ouvertes de mon équipe » (désactivée si l'un des deux est vide)
JIRA_OPEN_EPICS_TEAM=oda_Prenom_N
JIRA_OPEN_EPICS_STATUS=Ouvert
# Onglet Intégration : champ « Projet / Application » ; l'agent consulte tous les tickets de même valeur (ex. CANSON). Vide = désactivé
JIRA_APPLICATION_FIELD=customfield_10268
JIRA_APPLICATION_MAX_TICKETS=300

# --- Tickets créés par l'agent (tâches d'épopée, post-merge Cucumber) ---------
# Projet des tickets [CUCUMBER] post-merge (vide = JIRA_PROJECT_KEY)
POSTMERGE_JIRA_PROJECT=SPEC
# Composant Jira ou équipe Atlassian posé sur les tickets créés (vide = aucun)
POSTMERGE_JIRA_COMPONENT=oda_Prenom_N
POSTMERGE_JIRA_LABEL=WAIT_TEAM_SPEC
JIRA_POSTMERGE_ISSUE_TYPE=Development
# Vide = premier type existant parmi Tâche, Task, Development, Story
JIRA_EPIC_TASK_ISSUE_TYPE=
# Champ Jira « Team » (équipes Atlassian)
JIRA_TEAM_FIELD=customfield_10001

# --- Bitbucket / KISCloud (obligatoire) --------------------------------------
BITBUCKET_URL=https://git.kiscloud.io
# Jeton d'accès HTTP personnel (Bitbucket > Gérer le compte > Jetons d'accès HTTP), droits lecture
BITBUCKET_HTTP_TOKEN=
# Mode webhook uniquement : python -c "import secrets; print(secrets.token_hex(32))"
BITBUCKET_WEBHOOK_SECRET=

# --- Dépôts, conventions et prompts ------------------------------------------
# Socle Standard : URL du projet Bitbucket (cloné dans .tmp/) ou chemin d'un clone local (ex. C:/development/branch_dev)
BITBUCKET_STD_REPO_PATH=https://git.kiscloud.io/projects/COMPONENT
# Dépôt client pré-rempli dans l'onglet Lancement (URL de projet Bitbucket ou chemin local), facultatif
BITBUCKET_CLIENT_REPO_PATH=
# Cucumber Standard (https://git.kiscloud.io/projects/COMPONENT-QA/repos/cucumber/browse), au format clonable
BITBUCKET_CUCUMBER_STD_REPO=https://git.kiscloud.io/scm/component-qa/cucumber.git
# Vide = odatio-specific-code-conventions-dev.md à la racine du projet
DEV_CONVENTIONS_PATH=
# Dossier de prompts personnalisés : un <nom>.md présent ici remplace prompts/<nom>.md (vide = prompts du projet)
PROMPTS_DIR=

# --- Jenkins ------------------------------------------------------------------
JENKINS_URL=https://jenkins.kiscloud.io
JENKINS_USER=
JENKINS_API_TOKEN=
JENKINS_CUCUMBER_JOB=ODATIO_CUCUMBER_NIGHTLY

# --- Tests Cucumber des spécifiques d'un client (onglet Cucumber) -------------
# Spécifiques par lot (un appel Claude neuf par lot) et nombre maximal de tours de l'agent par lot
CUCUMBER_BATCH_SIZE=3
CUCUMBER_MAX_TURNS=25
# Motifs exclus de l'inventaire (vide = liste par défaut : pom.xml, kis.descriptor.yaml, *.md, target/, .idea/,
# tests unitaires, ressources statiques, configuration d'environnement… cf. DEFAULT_EXCLUDE_GLOBS dans tools/cucumber_tools.py)
CUCUMBER_EXCLUDE_GLOBS=
# Dépôts clients exclus de l'inventaire (vide = *-frontend,*-front,*-ui : écrans non testables en Cucumber)
CUCUMBER_EXCLUDE_REPOS=
# Motifs des fichiers de paramétrage et de messages (vide = *.properties,*i18n*,*messages*,*.sql,*param*.xml,*parameter*,*.csv)
CUCUMBER_PARAM_GLOBS=
# Score minimal (0 à 1) d'une feature du Cucumber Standard pour être rapprochée d'un spécifique (au plus 3 par
# spécifique, dont l'agent part pour écrire ses tests). Plus haut = moins de rapprochements, plus sûrs. Vide = 0.4
CUCUMBER_STD_MATCH_MIN=0.4
# Contrôle de pertinence après chaque lot : similarité (0 à 1, titre ou steps) au-delà de laquelle un scénario est
# signalé comme doublon d'un scénario Standard ou client ; tours de l'appel de revue des scénarios signalés
CUCUMBER_DUP_THRESHOLD=0.85
CUCUMBER_REVIEW_MAX_TURNS=8
# Vérification de la pertinence par exécution (sans token ; sans job ni commande : « pertinence non vérifiée »)
# Job Jenkins dédié acceptant PATCH (fichier), TAGS, ENV, CUCUMBER_SPEC_REPOSITORY et archivant le rapport Cucumber
# JSON ; CUCUMBER_SPEC_COMMIT et CUCUMBER_STANDARD_COMMIT (recommandés) fixent les commits de base de l'agent
# (proposition : jenkins/CUCUMBER-VERIFY-PATCH.Jenkinsfile ; aucun job existant ne prend un patch en fichier)
CUCUMBER_VERIFY_JOB=
# Environnements déjà démarrés : client (scénarios et mutations) et Standard de même version (contre-épreuve des overrides)
CUCUMBER_VERIFY_ENV=
CUCUMBER_VERIFY_ENV_STD=
# Repli local si pas de job : commande lancée dans .tmp/cucumber/<client>/build, {tags} et {env} remplacés,
# rapport lu dans target/**/cucumber*.json. Ex. : mvn -q test "-Dcucumber.filter.tags={tags}" -Dhttps=https -Durl={env} -Dws=wss -DuserName=admin -Dpassword=<base64>
CUCUMBER_VERIFY_LOCAL_CMD=
# Durée maximale d'une exécution (s) ; appels de correction des scénarios invalides / faibles avant retrait
CUCUMBER_VERIFY_TIMEOUT=3600
CUCUMBER_VERIFY_FIX_ATTEMPTS=1
# Scénarios « pertinent » proposés à la revue humaine dans l'onglet Cucumber
CUCUMBER_REVIEW_SAMPLE=5
# 1 = conserver les tags de vérification @agent_<client>_<lot>[_<n>] dans le patch livré (0 : retirés du patch)
CUCUMBER_KEEP_AGENT_TAGS=0
# 1 = environnement client lancé avec l'agent JaCoCo : part des classes de chaque spécifique exécutées
# (jacoco.exec archivé par le job, ou chemin local CUCUMBER_JACOCO_EXEC)
CUCUMBER_JACOCO=0
CUCUMBER_JACOCO_EXEC=
# Compilation après chaque lot, en Python (vide = pas de compilation). Dépôt client sans pom.xml : compilé par-dessus
# une copie du Cucumber Standard (.tmp/cucumber/<client>/build). Hors ligne en échec faute de dépendances : relancé en ligne.
CUCUMBER_COMPILE_CMD=mvn -q -o test-compile
# Compilation en échec : appels de correction au plus par lot, et tours de l'agent par appel
CUCUMBER_FIX_ATTEMPTS=2
CUCUMBER_FIX_MAX_TURNS=10
# 1 = dry-run Cucumber des features du lot après compilation (steps sans définition détectés sans rien exécuter)
CUCUMBER_DRY_RUN=0

# --- Post-merge Cucumber et écoute des merges ---------------------------------
# Projets écoutés : PROJET (tous ses dépôts) ou PROJET/depot, séparés par des virgules
POLL_REPOSITORIES=NOVALIA
POLL_INTERVAL_SECONDS=300
# Dépôt Cucumber de chaque client (vide = détection du dépôt *cucumber* du projet)
POSTMERGE_CUCUMBER_REPOS=NOVALIA=novalia-cucumber-2
POSTMERGE_CUCUMBER_BASE_BRANCH=integration
WEBHOOK_TARGET_BRANCHES=integration,dev
WEBHOOK_IGNORED_REPOS=cucumber
# Vide = déduit de BITBUCKET_STD_REPO_PATH
WEBHOOK_STD_PROJECT=
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8085
# Tests uniquement
WEBHOOK_ALLOW_UNSIGNED=false
WEBHOOK_DRY_RUN=false

# --- Claude Code --------------------------------------------------------------
# Vide = abonnement Claude (Pro / Max / Team) de la CLI `claude` connectée
ANTHROPIC_API_KEY=
# Modèle par étape : alias (sonnet, opus, haiku) ou identifiant complet ; vide = modèle par défaut
CLAUDE_MODEL_CADRAGE=
CLAUDE_MODEL_REFINE=
CLAUDE_MODEL_PATCH=
CLAUDE_MODEL_POSTMERGE=
CLAUDE_MODEL_BESOIN=
# Génération des tests Cucumber des spécifiques d'un client (onglet Cucumber), modèle de chaque lot (vide = sonnet)
CLAUDE_MODEL_CUCUMBER=sonnet
# Taille maximale du contexte Jira et de la mémoire injectés dans les prompts (0 = désactivé)
JIRA_CONTEXT_MAX_CHARS=12000
MEMORY_MAX_CHARS=6000

# --- Base de données client, lecture seule (facultatif) ----------------------
# postgresql | oracle | sqlserver | mysql
DB_TYPE=postgresql
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=
# SQL Server via pyodbc uniquement
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server

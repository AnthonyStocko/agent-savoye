# Modèle de .streamlit/secrets.toml (connexion OIDC, AGENT_AUTH=1). Le vrai fichier n'est JAMAIS commité :
# il est créé par « python -m tools.auth_setup » (voir README, « Connexion OIDC »).

[auth]
# URL de retour : <adresse de l'application>/oauth2callback, déclarée à l'identique dans l'enregistrement de
# l'application chez le fournisseur (http accepté pour localhost ; https sinon)
redirect_uri = "http://localhost:8501/oauth2callback"
# Secret aléatoire signant le cookie de session (généré par tools.auth_setup)
cookie_secret = "<chaîne aléatoire longue>"
# Enregistrement de l'application chez le fournisseur d'identité
client_id = "<identifiant de l'application (client)>"
client_secret = "<secret client>"
# Entra ID : https://login.microsoftonline.com/<tenant>/v2.0/.well-known/openid-configuration
server_metadata_url = "<URL .well-known/openid-configuration du fournisseur>"
